+def test_extract_tool_level_uses_results_available_at_each_call_start():
+    offset = timezone(timedelta(hours=2))
+
+    def tool_span(name, start, end, result, arguments=None):
+        return ToolExecutionSpan(
+            span_info=SpanInfo(session_id="test", start_time=start, end_time=end),
+            tool_call=ToolCall(name=name, arguments=arguments or {}, tool_call_id=name),
+            tool_result=ToolResult(content=result, tool_call_id=name),
+        )
+
+    previous = tool_span("previous_turn", datetime(2026, 1, 1, 9), datetime(2026, 1, 1, 9, 1), "prior")
+    agent = AgentInvocationSpan(
+        span_info=SpanInfo(
+            session_id="test",
+            start_time=datetime(2026, 1, 1, 10),
+            end_time=datetime(2026, 1, 1, 10, 6),
+        ),
+        user_prompt="What is (3 + 4) * 5?",
+        agent_response="35",
+        available_tools=[],
+    )
+    add = tool_span(
+        "add_numbers",
+        datetime(2026, 1, 1, 12, 1, tzinfo=offset),
+        datetime(2026, 1, 1, 12, 3, tzinfo=offset),
+        "7",
+        {"a": 3, "b": 4},
+    )
+    running = tool_span(
+        "still_running",
+        datetime(2026, 1, 1, 12, 1, 30, tzinfo=offset),
+        datetime(2026, 1, 1, 12, 5, tzinfo=offset),
+        "late result",
+    )
+    multiply = tool_span(
+        "multiply_numbers",
+        datetime(2026, 1, 1, 10, 3),
+        datetime(2026, 1, 1, 10, 3, 30),
+        "35",
+        {"a": 7, "b": 5},
+    )
+    later = tool_span("later_call", datetime(2026, 1, 1, 10, 4), datetime(2026, 1, 1, 10, 4, 30), "later")
+    session = Session(
+        traces=[
+            Trace(spans=[previous], trace_id="previous", session_id="test"),
+            Trace(spans=[agent, later, multiply, running, add], trace_id="current", session_id="test"),
+        ],
+        session_id="test",
+    )
+
+    inputs = TraceExtractor(EvaluationLevel.TOOL_LEVEL).extract(session)
+
+    assert [item.tool_execution_details.tool_call.name for item in inputs] == [
+        "previous_turn",
+        "add_numbers",
+        "still_running",
+        "multiply_numbers",
+        "later_call",
+    ]
+    histories = [
+        [execution.tool_call.name for entry in item.session_history if isinstance(entry, list) for execution in entry]
+        for item in inputs
+    ]
+    assert histories == [
+        [],
+        ["previous_turn"],
+        ["previous_turn"],
+        ["previous_turn", "add_numbers"],
+        ["previous_turn", "add_numbers", "multiply_numbers"],
+    ]
+    assert inputs[3].session_history[-1] == [ToolExecution(tool_call=add.tool_call, tool_result=add.tool_result)]
+    for evaluator in (ToolParameterAccuracyEvaluator(), ToolSelectionAccuracyEvaluator()):
+        prompt = evaluator._format_tool_level_prompt(inputs[3])
+        assert "Tool result: 7" in prompt
+        assert "Tool result: 35" not in prompt
+        assert "late result" not in prompt
+        assert "Tool call: multiply_numbers({'a': 7, 'b': 5})" in prompt
+
+
+def test_extract_tool_level_filters_results_from_overlapping_previous_trace():
+    def tool_span(name, start, end):
+        return ToolExecutionSpan(
+            span_info=SpanInfo(session_id="test", start_time=start, end_time=end),
+            tool_call=ToolCall(name=name, arguments={}),
+            tool_result=ToolResult(content=name),
+        )
+
+    early = tool_span("early", datetime(2026, 1, 1, 10), datetime(2026, 1, 1, 10, 1))
+    pending = tool_span("pending", datetime(2026, 1, 1, 10), datetime(2026, 1, 1, 10, 5))
+    target = tool_span("target", datetime(2026, 1, 1, 10, 3), datetime(2026, 1, 1, 10, 4))
+    session = Session(
+        traces=[
+            Trace(spans=[early, pending], trace_id="previous", session_id="test"),
+            Trace(spans=[target], trace_id="current", session_id="test"),
+        ],
+        session_id="test",
+    )
+
+    inputs = TraceExtractor(EvaluationLevel.TOOL_LEVEL).extract(session)
+
+    assert inputs[2].session_history == [[ToolExecution(tool_call=early.tool_call, tool_result=early.tool_result)]]
+
+
 def test_extract_session_level(session_with_conversation):
