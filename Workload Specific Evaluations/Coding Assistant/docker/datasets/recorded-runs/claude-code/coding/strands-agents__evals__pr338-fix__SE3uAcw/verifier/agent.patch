+from datetime import datetime, timedelta, timezone
 
 import pytest
 
@@ -157,3 +157,33 @@ def test_extract_empty_session_tool_level():
 
     assert isinstance(result, list)
     assert len(result) == 0
+
+
+def test_extract_tool_level_includes_earlier_results_in_same_turn():
+    base = datetime(2025, 1, 1, 12, 0, 0)  # naive means UTC
+    aware = base.replace(tzinfo=timezone.utc)
+
+    def span(sid, start, end, name, result):
+        return ToolExecutionSpan(
+            span_info=SpanInfo(session_id="s", span_id=sid, start_time=start, end_time=end),
+            tool_call=ToolCall(name=name, arguments={}),
+            tool_result=ToolResult(content=result),
+        )
+
+    add = span("1", base, base + timedelta(seconds=1), "add", "7")  # naive
+    mul = span("2", aware + timedelta(seconds=1), aware + timedelta(seconds=2), "mul", "35")  # aware, starts at add end
+    running = span("3", aware + timedelta(seconds=1, milliseconds=500), aware + timedelta(seconds=5), "slow", "x")
+    session = Session(
+        traces=[Trace(spans=[mul, add, running], trace_id="t", session_id="s")],
+        session_id="s",
+    )
+
+    inputs = TraceExtractor(EvaluationLevel.TOOL_LEVEL).extract(session)
+    by_name = {i.tool_execution_details.tool_call.name: i for i in inputs}
+
+    def seen(name):
+        return [e.tool_call.name for h in by_name[name].session_history if isinstance(h, list) for e in h]
+
+    assert seen("add") == []
+    assert seen("mul") == ["add"]
+    assert seen("slow") == ["add"]
