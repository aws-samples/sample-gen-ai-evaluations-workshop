index 600de26..2bad13f 100644
--- a/src/strands_evals/types/trace.py
+++ b/src/strands_evals/types/trace.py
@@ -136,17 +136,23 @@ def _find_root_agent_span(agent_spans: Sequence[AgentInvocationSpan]) -> AgentIn
     """Search for a trace's root agent span.
 
     Prefers a parentless agent that has content, then any parentless agent,
-    then the earliest by `start_time`. Returns `None` for an empty sequence.
+    then any agent; the earliest by `start_time` wins within each tier, so the
+    result does not depend on span order. Returns `None` for an empty sequence.
     """
     if not agent_spans:
         return None
-    for span in agent_spans:
-        if span.span_info.parent_span_id is None and (span.user_prompt or span.agent_response):
-            return span
-    for span in agent_spans:
-        if span.span_info.parent_span_id is None:
-            return span
-    return min(agent_spans, key=lambda s: _to_aware_utc(s.span_info.start_time))
+
+    def earliest(spans: Sequence[AgentInvocationSpan]) -> AgentInvocationSpan:
+        # min() is stable, so ties keep the original list order
+        return min(spans, key=lambda s: _to_aware_utc(s.span_info.start_time))
+
+    parentless = [s for s in agent_spans if s.span_info.parent_span_id is None]
+    with_content = [s for s in parentless if s.user_prompt or s.agent_response]
+    if with_content:
+        return earliest(with_content)
+    if parentless:
+        return earliest(parentless)
+    return earliest(agent_spans)
 
 
 class Trace(BaseModel):
