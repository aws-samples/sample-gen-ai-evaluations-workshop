+@pytest.mark.parametrize("coordinator_first", [True, False])
+def test_tool_level_root_is_earliest_agent_when_all_parentless(coordinator_first):
+    """Session history uses the earliest parentless agent regardless of span order."""
+
+    def info(span_id: str, second: int) -> SpanInfo:
+        t = datetime(2026, 1, 1, 0, 0, second, tzinfo=timezone.utc)
+        return SpanInfo(session_id="test", span_id=span_id, start_time=t, end_time=t)
+
+    coordinator = AgentInvocationSpan(
+        span_info=info("coordinator", 0),
+        user_prompt="temperature difference between Paris and Tokyo",
+        agent_response="done",
+        available_tools=[],
+    )
+    sub = AgentInvocationSpan(
+        span_info=info("sub", 1),
+        user_prompt="temperature in Tokyo",
+        agent_response="20",
+        available_tools=[ToolConfig(name="calculate")],
+    )
+    tool = ToolExecutionSpan(
+        span_info=info("tool", 2),
+        tool_call=ToolCall(name="calculate", arguments={"expr": "25-20"}),
+        tool_result=ToolResult(content="5"),
+        agent_span_id="sub",
+    )
+    spans = [coordinator, sub, tool] if coordinator_first else [sub, coordinator, tool]
+    session = Session(traces=[Trace(spans=spans, trace_id="t", session_id="test")], session_id="test")
+
+    inputs = TraceExtractor(EvaluationLevel.TOOL_LEVEL).extract(session)
+
+    assert len(inputs) == 1
+    first = inputs[0].session_history[0]
+    assert first.content[0].text == "temperature difference between Paris and Tokyo"
