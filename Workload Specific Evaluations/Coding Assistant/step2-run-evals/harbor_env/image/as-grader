#!/bin/bash
# as-agent, but as uid grader with its own HOME: the trusted grading stage.
[ "$(cat /run/fw.status 2>/dev/null | grep -v '^$')" = OK ] || { echo "firewall not ready" >&2; exit 111; }
mapfile -t E < <(cat /opt/firewall/task.env /run/fw/extra.env 2>/dev/null | grep -v '^$')
exec nsenter --net=/run/fw/agent.net -- setpriv --reuid=grader --regid=grader --init-groups --no-new-privs \
  env -i "${E[@]}" HOME=/home/grader USER=grader LOGNAME=grader SHELL=/bin/bash \
  AWS_CONFIG_FILE=/dev/null AWS_SHARED_CREDENTIALS_FILE=/dev/null \
  HTTPS_PROXY=http://127.0.0.1:3128 https_proxy=http://127.0.0.1:3128 \
  HTTP_PROXY=http://127.0.0.1:3128 http_proxy=http://127.0.0.1:3128 \
  bash -c "$1"
