# Copy this file to `.env` and fill in your values.
# Each notebook loads `.env` in its first code cell (env_setup.load_env).
# .env itself is gitignored. Never commit real credentials.

# The Region for the Bedrock calls. The tasks in datasets/ allow only the Bedrock endpoint in
# us-east-1. If you change the Region, also change allowed_hosts in each task.toml.
AWS_REGION=us-east-1

# A named profile from ~/.aws/config. Leave it commented out to use the default credential chain
# (environment variables, ~/.aws/credentials, or the [default] profile).
#
# At Amazon: you usually have no default credentials. Set this to the Isengard profile of the
# account that has Bedrock access, for example a profile that uses
# `credential_process = isengardcli credentials ...` or `ada credentials print ...`.
# AWS_PROFILE=your-profile-name
