# Generated by step1-build-tasks/coding_tasks.py for {task_name}. The repository {repository} at the parent commit of
# the pull request's merge ({base_short}), with its dependencies installed. Not in this image: the
# repository's history, the change the task asks for, and the hidden tests (they are in tests/, which
# Harbor adds only for grading).
FROM {image}
ENV CI=1{environment_lines}
RUN (command -v git && command -v python3) >/dev/null 2>&1 || (apt-get update \
 && apt-get install -y --no-install-recommends git python3 ca-certificates \
 && rm -rf /var/lib/apt/lists/*)
# /work/repo is where this module's staged grader (harbor_env/agentcore_env.py) looks for the repository.
WORKDIR /work/repo
COPY repo.tar.gz /tmp/task-repo.tar.gz
RUN tar -xzf /tmp/task-repo.tar.gz -C /work/repo --no-same-owner && rm /tmp/task-repo.tar.gz
{install_lines}# A fresh repository with one commit, the base, tagged task-base: no history to read the change from.
RUN git init -q \
 && git config user.name task-builder && git config user.email task-builder@localhost \
 && git add -A \
 && GIT_AUTHOR_DATE=2000-01-01T00:00:00Z GIT_COMMITTER_DATE=2000-01-01T00:00:00Z \
    git commit -q -m "Repository at the task's base commit" \
 && git tag task-base \
 && git rev-parse HEAD > /var/lib/task_base_ref
{agent_setup_lines}