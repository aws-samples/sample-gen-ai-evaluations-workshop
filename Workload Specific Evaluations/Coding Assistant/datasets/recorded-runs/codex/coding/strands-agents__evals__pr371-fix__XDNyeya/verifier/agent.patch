+
+
+@pytest.mark.parametrize("coordinator_first", [True, False])
+@patch("strands_evals.evaluators.tool_selection_accuracy_evaluator.Agent")
+def test_flat_multi_agent_trace_uses_original_request(mock_agent_class: Mock, coordinator_first: bool) -> None:
+    start = datetime(2026, 1, 1, tzinfo=timezone.utc)
+
+    def span_info(span_id: str, seconds: int) -> SpanInfo:
+        timestamp = start + timedelta(seconds=seconds)
+        return SpanInfo(session_id="test-session", span_id=span_id, start_time=timestamp, end_time=timestamp)
+
+    original_request = "What is the temperature difference between Paris and London?"
+    coordinator = AgentInvocationSpan(
+        span_info=span_info("coordinator", 0),
+        user_prompt=original_request,
+        agent_response="The difference is 5 degrees.",
+        available_tools=[ToolConfig(name="ask_weather_agent")],
+    )
+    weather_agent = AgentInvocationSpan(
+        span_info=span_info("weather-agent", 1),
+        user_prompt="Get the temperature in Paris.",
+        agent_response="Paris is 20 degrees.",
+        available_tools=[ToolConfig(name="get_temperature")],
+    )
+    math_agent = AgentInvocationSpan(
+        span_info=span_info("math-agent", 2),
+        user_prompt="Subtract 15 from 20.",
+        agent_response="5",
+        available_tools=[ToolConfig(name="calculate")],
+    )
+    calculate = ToolExecutionSpan(
+        span_info=span_info("calculate-tool", 3),
+        tool_call=ToolCall(name="calculate", arguments={"expression": "20 - 15"}),
+        tool_result=ToolResult(content="5"),
+        agent_span_id="math-agent",
+    )
+    agents = [coordinator, weather_agent, math_agent] if coordinator_first else [weather_agent, math_agent, coordinator]
+    trace = Trace(spans=[*agents, calculate], trace_id="trace1", session_id="test-session")
+    case = EvaluationData(
+        input=original_request,
+        actual_output="The difference is 5 degrees.",
+        actual_trajectory=Session(traces=[trace], session_id="test-session"),
+        name="temperature-difference",
+    )
+    mock_agent_class.return_value.return_value.structured_output = ToolSelectionRating(
+        reasoning="The calculation serves the original request.", score=ToolSelectionScore.YES
+    )
+
+    result = ToolSelectionAccuracyEvaluator().evaluate(case)
+
+    assert result[0].test_pass is True
+    prompt = mock_agent_class.return_value.call_args.args[0]
+    assert f"User: {original_request}" in prompt
+    assert "User: Get the temperature in Paris." not in prompt
+    assert "- calculate:" in prompt
