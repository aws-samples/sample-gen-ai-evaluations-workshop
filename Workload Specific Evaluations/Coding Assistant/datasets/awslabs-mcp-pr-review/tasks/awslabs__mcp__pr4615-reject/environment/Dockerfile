# Sealed agent environment (FR-30). Generated by eval-harvest emit, then changed for this workshop:
# the base image has Node.js, the server's Python dependencies are installed, and Codex is installed
# at the end of the file.
#
# The container is sealed against the repository's future: the agent sees the code at the base
# state with the change under review applied as uncommitted working-tree edits, and nothing that
# would let it reach the fix, the review discussion, or any later commit. Every sealing step below
# is load-bearing — a build produces a tree the seal checks (Seal.check_repo) pass on.
#
# Three container checks are skipped here, each because Harbor owns the thing the check asks for.
# Harbor appends a harness stanza to whatever this file ends with — `USER root`, `ENTRYPOINT []`,
# `CMD ["/agentd"]` (lambda_microvms.py:141-150, harness_dockerfile) — so the end of this file is
# not the end of the image:
# checkov:skip=CKV_DOCKER_3:A USER here is overridden — Harbor appends `USER root` after it, on purpose ("restores the daemon's privileges when a task Dockerfile ends on a non-root user; per-exec demotion is the daemon's job"). Adding one would claim a posture the built image does not have.
# checkov:skip=CKV_DOCKER_2:Nothing in this image serves a health-checkable endpoint. The image is built, then Harbor replaces the entrypoint with its agent daemon, whose liveness Harbor tracks itself.
# checkov:skip=CKV_DOCKER_7:`public.ecr.aws/docker/library/buildpack-deps:bookworm-scm` is a placeholder, not a ref — no tag can be written here. The emitter substitutes a pinned, non-latest ECR Public tag (`_AGENT_BASE_IMAGE = "public.ecr.aws/docker/library/buildpack-deps:bookworm-scm"`, emit.py:80).
# node:22-bookworm is buildpack-deps:bookworm with Node.js added.
FROM public.ecr.aws/docker/library/node:22-bookworm

WORKDIR /work

# A shallow, single-branch, no-tags clone: only the base commit's tree, none of the history around
# it, and no tag pointing at a later state.
RUN git clone --depth 1 --single-branch --no-tags "https://github.com/awslabs/mcp.git" repo
WORKDIR /work/repo

# Fetch exactly the base commit and reset the working tree to it — the state *before* this change.
RUN git fetch --depth 1 origin 27e3e60edb78d541a7a034d5c3d38f181a79b397 \
 && git reset --hard 27e3e60edb78d541a7a034d5c3d38f181a79b397

# Seal the repository: remove the remote (no network channel back to the forge), delete every
# remote-tracking ref, expire the reflog (a superseded state is retrievable through it otherwise),
# and prune everything now unreachable — so a single reachable commit remains.
RUN git remote remove origin \
 && git for-each-ref --format='%(refname)' refs/remotes | xargs -r -n1 git update-ref -d \
 && git reflog expire --expire=now --all \
 && git gc --prune=now --aggressive

# Apply the change under review as uncommitted working-tree edits: the agent reviews the diff, and
# the diff is never committed, so the sealed history still names only the base commit. The patch file
# stays at /work/change.patch (outside the repository), where instruction.md tells the agent to find it.
COPY change.patch /work/change.patch
RUN git apply --whitespace=nowarn /work/change.patch

# Python and the locked dependencies of the changed server, installed at build time against the
# patched tree, so the agent can import the code and run its tests. The environment is outside the
# repository, so `git status` still shows only the change. At run time uv is offline: the agent's
# allowlist has no package index, and everything that the tests need is already installed.
COPY --from=ghcr.io/astral-sh/uv:0.13.0 /uv /uvx /usr/local/bin/
ENV UV_PROJECT_ENVIRONMENT=/opt/venv UV_PYTHON_INSTALL_DIR=/opt/uv-python UV_LINK_MODE=copy
RUN cd src/mysql-mcp-server && uv sync --frozen --all-extras \
 && /opt/venv/bin/python -m pytest --version
ENV PATH="/opt/venv/bin:${PATH}" VIRTUAL_ENV=/opt/venv UV_OFFLINE=1 UV_NO_SYNC=1
# Codex runs each command in a login shell (`bash -lc`). Debian's /etc/profile sets PATH again and
# drops /opt/venv/bin, so put it back for login shells too.
RUN echo 'export PATH="/opt/venv/bin:$PATH"' > /etc/profile.d/00-venv.sh

# A HOME that is not /root. Harbor runs the agent as root, and some server code treats paths under
# /root as sensitive (for example eks-mcp-server's path validation). With HOME=/root, a test that
# uses ~/projects fails before the change too, which would mislead the review.
ENV HOME=/home/reviewer
RUN mkdir -p /home/reviewer

# The environment must be sound: the full test suite of the changed server passes on the base with
# the change applied. If a test fails here, the build fails, and the datapoint is not used.
RUN cd src/mysql-mcp-server && python -m pytest -q -p no:cacheprovider

# Codex, installed at build time: the build has open network, the agent has only its Bedrock
# allowlist. Harbor finds `codex` on PATH and skips its own npm install, which needs the network.
RUN npm install -g @openai/codex@0.162.1 \
 && apt-get update && apt-get install --no-install-recommends --yes ripgrep \
 && apt-get clean && rm -rf /var/lib/apt/lists/* \
 && codex --version
